// ThinkPad E16 Gen 3: 16" 1920x1200 @ 60 Hz panel. External screens via
// HDMI 2.1 / USB-C get placed to the right automatically.
output "eDP-1" {
    mode "1920x1200@60.000"
    scale 1.0
    position x=0 y=0
}

// 60 Hz has too few frames to carry a spring without stepping, so the
// workspace and column movements switch instantly instead.
animations {
    slowdown 1.0
    window-open {
        duration-ms 130
        curve "ease-out-quad"
    }
    window-close {
        duration-ms 110
        curve "ease-out-quad"
    }
    workspace-switch {
        off
    }
    horizontal-view-movement {
        off
    }
}
